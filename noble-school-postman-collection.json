    {
      "name": "Notifications",
      "item": [
        {
          "name": "Trigger Bulk Absent SMS",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Status check",
                  "pm.test(\"Status code is 201 Created or 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "// Assert successful broadcast trigger checks",
                  "pm.test(\"System successfully parsed attendance and triggered SMS logs\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.sentCount).to.be.a('number');",
                  "    pm.expect(jsonData.notifications).to.be.an('array');",
                  "    ",
                  "    // If absent students exist, verify details logic",
                  "    if (jsonData.sentCount > 0) {",
                  "        pm.expect(jsonData.notifications[0].status).to.eql('sent');",
                  "        pm.expect(jsonData.notifications[0].triggerType).to.eql('absent-sms');",
                  "        pm.expect(jsonData.notifications[0].parentPhone).to.not.be.empty;",
                  "        pm.expect(jsonData.notifications[0].message).to.contain('ABSENT');",
                  "        console.log(\"Verified SMS triggers for \" + jsonData.sentCount + \" absent students.\");",
                  "    } else {",
                  "        console.log(\"No absent students to verify notification triggers.\");",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-06-01\",\n  \"className\": \"10\",\n  \"section\": \"A\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
