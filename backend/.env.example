PORT=5000
NODE_ENV=production

# MongoDB connection string (Atlas or self-hosted). If it can't connect, the
# server falls back to database/db-fallback.json.
MONGODB_URI=mongodb://localhost:27017/noble-school

# Random secret used to sign login sessions. At least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=12h

# Extra browser origins allowed to call the API (comma separated).
ALLOWED_ORIGINS=https://noble-high-school-management.onrender.com

# Admin OTP email delivery: Resend API key, or Gmail SMTP with an app password.
RESEND_API_KEY=
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Razorpay keys for online fee payment (leave empty to disable online payment).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Only used the first time the server creates the admin account.
ADMIN_INITIAL_PASSWORD=
